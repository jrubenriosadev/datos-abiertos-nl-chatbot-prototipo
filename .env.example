# Copia este archivo como ".env" y llena tus valores. Nunca subas ".env" a ningún repositorio.

# Clave de la API de Gemini (se genera en Google AI Studio)
GEMINI_API_KEY=pon_aqui_tu_clave

# Nombre del modelo. Verifica en https://ai.google.dev/gemini-api/docs/models que siga vigente.
# Verificado el 28/10/2026: gemini-3.1-flash-lite es estable (retiro más temprano: 7/05/2027);
# Google recomienda gemini-3.5-flash-lite para proyectos nuevos.
GEMINI_MODEL=gemini-3.1-flash-lite

# Servidor local
HOST=127.0.0.1
PORT=8000

# Orígenes permitidos para el frontend (separados por coma).
# La página se abre en http://localhost:8000/ (la sirve el backend: mismo origen, no necesita CORS).
# Agrega aquí otros orígenes solo si sirves la página desde otro servidor (por ejemplo, el puerto 5500).
# El origen "null" (abrir index.html con doble clic) nunca se permite.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Límites de uso (protegen tu cuota y limitan el abuso)
MAX_MESSAGE_LENGTH=500
MAX_MESSAGES_PER_SESSION=30
RATE_LIMIT_PER_MINUTE=20
# Tokens para el texto de cada respuesta. El backend suma una reserva fija (2048) para el
# razonamiento interno del modelo, que en Gemini 3 cuenta dentro del mismo límite.
MAX_OUTPUT_TOKENS=1200
MAX_TOOL_CALLS_PER_TURN=6
# Filas por consulta (tope absoluto: 200)
MAX_ROWS_PER_QUERY=200
